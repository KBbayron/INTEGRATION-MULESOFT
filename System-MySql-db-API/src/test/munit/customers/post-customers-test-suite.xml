<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="post-customers-test-suite.xml" />
	<munit:test name="post-customers-test-suite-post-customers-flowTest" doc:id="1faa4620-fee8-4df1-a293-f4bf4df21986" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="0b984130-fbb8-47a4-9f45-82e8c9be7439" processor="db:insert">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="post-customer-db" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="customerAdded" value='#[{&#10;        "generatedKeys": [1]&#10;}]' mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="efb20fc5-b3a7-48f6-918e-7bd12b377a79" >
				<munit:payload value="#[readUrl('classpath://post-customer.json', 'application/json')]" />
				<munit:attributes value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;    method: "POST",&#10;    requestPath: "/api/v1/customers"&#10;}]' />
				<munit:variables >
					<munit:variable key="correlationId" value='"67bdbd80-8cea-11f1-a317-86e22729da3c"' />
					<munit:variable key="saveMethod" value='"POST"' />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post-customers-flow" doc:id="ad1cfe1c-384b-4393-bc12-aca06982d58d" name="post-customers-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="6e39d80d-747d-463b-a587-68d72fbf9ed9" is="#[MunitTools::equalTo(readUrl('classpath://post-customer-response.json', 'application/json') update {&#10;	case .timestamp -&gt; payload.timestamp&#10;})]" expression="#[payload]"/>
		</munit:validation>
	</munit:test>

</mule>
