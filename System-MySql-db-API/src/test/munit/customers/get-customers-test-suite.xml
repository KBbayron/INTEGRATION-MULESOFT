			<flow-ref doc:name="Flow-ref to get-customers-flow" doc:id="d42c3eff-ee29-4ef6-9a00-a3f47ad134a3" name="get-customers-flow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="f13f3b8c-b0d5-4087-8d15-77b06636c4df" is="#[MunitTools::notNullValue()]" expression="#[payload]" />
		</munit:validation>
