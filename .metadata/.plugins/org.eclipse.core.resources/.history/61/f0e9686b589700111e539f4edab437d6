<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="post-orders" doc:id="5f7581c0-2eb7-4314-a180-d8a825eceb19" >
		<logger level="INFO" doc:name="initial-post-oder-logger" doc:id="08c9151c-b271-40c9-9749-a9146bf4febf" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: vars.env,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,                             &#10;    message: &quot;Initiating order post request to PAPI&quot;&#10;}]" />
		<set-variable value="#[payload]" doc:name="orderData" doc:id="c45f49ca-d03f-4d55-b7c4-95fa48cfc110" variableName="orderData" />
		<http:request method="GET" doc:name="Request-for-customer" doc:id="56afff94-1ed8-42dc-b43e-56e23fc3f3b0" config-ref="HTTP_Request_apy-sys" path="${api-sys.path.customers}/{userId}" responseTimeout="30000" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"X-Correlation-ID" : vars.correlationId,
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/json
---
{
	"userId" : payload.userId 
}]]]></http:uri-params>
		</http:request>
		<choice doc:name="validate-user-extis" doc:id="e95e5b09-fd46-4909-bd2a-d0633c7c4468" >
			<when expression='#[payload.status == "Fail"]' >
				<ee:transform doc:name="set-not-order-founded" doc:id="ccb21ea6-00dc-4e6c-a887-66e49a8e0314" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  Message: "There isn't customer with ID=" ++ vars.orderData.userId ++ " to add orders"
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
404]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="final-logger-post-order" doc:id="a8f82e88-8584-4e48-838c-6465c9dd1e72" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: Mule::p('mule.env') default &quot;local&quot;,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,   &#10;    details:{&#10;	    message: payload.Message&#10;    }                          &#10;}]" />
			</when>
			<otherwise >
				<ee:transform doc:name="set-body-to-papi" doc:id="46034a4a-1e3d-4841-808d-fcefd4aae06a" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"userId": vars.orderData.userId,
  	"productName": vars.orderData.productName,
  	"brand": vars.orderData.brand,
  	"price": vars.orderData.price,
  	"quantity": vars.orderData.quantity,
  	"discount": vars.orderData.discount,
  	"orderDate": now() as String {format: "yyyy-MM-dd"}

}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<http:request method="POST" doc:name="request-post-order-sapi" doc:id="09f57600-9a9b-4822-be9d-754c93e8370b" config-ref="HTTP_Request_apy-sys" path="${api-sys.path.orders}" responseTimeout="30000" >
					<http:headers ><![CDATA[#[output application/java
---
{
	"X-Correlation-ID" : vars.correlationId
}]]]></http:headers>
				</http:request>
				<ee:transform doc:name="set-final-message-oder-added" doc:id="0198ae49-7303-40ba-bb87-b9622e19aa7b" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	message: "Order added successfully",
	new_order: payload.data
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="final-logger-post-order" doc:id="761e5395-4c5e-42fe-867e-09edcabd9287" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: Mule::p('mule.env') default &quot;local&quot;,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,   &#10;    details:{&#10;	    message: &quot;Order successfully post into PAPI.&quot;,&#10;	    affected_rows: payload.affectedRows default 1 ,&#10;	    data_update: payload.new_order&#10;&#10;    }                          &#10;}]" />
			</otherwise>
		</choice>
		<error-handler >
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="bc8fc533-d170-45eb-a6fe-8a4f6586d67e" >
				<logger level="INFO" doc:name="set-error-logger" doc:id="1819e291-bee9-4259-911d-a678f0bdf81c" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  "log_type": "SYSTEM_API_ERROR",&#10;  "API_NAME": app.name,&#10;  "correlation_id": vars.correlationId,&#10;  "flow_name": flow.name,&#10;  httpMethod: attributes.method,&#10;  "timestamp": now(),&#10;  "details": {&#10;    "target_id": attributes.uriParams.id default "UNKNOWN",&#10;    "error_type": (error.errorType.namespace default "DB") ++ ":" ++ (error.errorType.identifier default "UNKNOWN"),&#10;    "error_description": error.description default "No description available",&#10;    "message": "Failed to "++ attributes.method ++ " order from PAPI."&#10;  }&#10;}]' />
				<ee:transform doc:name="set-error-message" doc:id="b5e5459b-8c83-4f4d-9d7e-423318058ac5" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "success": false,
  "correlationId": vars.correlationId,
  "error": {
    "code": if (error.errorType.identifier == "CONNECTIVITY") "SERVICE_UNAVAILABLE" else "INTERNAL_SERVER_ERROR",
    "message": "Error processing the request on the target process.",
    "description": error.description default "No technical details available",
    "timestamp": now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
  }
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-continue>
		</error-handler>
	</flow>
</mule>
