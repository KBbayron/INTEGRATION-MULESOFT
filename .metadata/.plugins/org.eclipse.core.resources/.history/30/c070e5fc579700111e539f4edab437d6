<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<flow name="delete-customers" doc:id="fba90133-2454-4a46-a70c-a292569be1db" >
		<logger level="INFO" doc:name="Logger" doc:id="0c3f4d71-21e7-4c6c-bea9-be6b085ad867" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: vars.env,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,                             &#10;    message: &quot;Initiating customer delete request to PAPI&quot;&#10;}]" />
		<set-variable value="#[attributes.uriParams.customerId]" doc:name="id" doc:id="963df419-6854-4e7d-a6f5-caa027a10c58" variableName="id" />
		<http:request method="GET" doc:name="get-customer" doc:id="597df20b-57fd-4dcd-9ea4-d90f3c0683ba" config-ref="HTTP_Request_apy-sys" path="${api-sys.path.customers}" responseTimeout="300000">
			<http:headers><![CDATA[#[output application/java
---
{
	"X-Correlation-ID" : vars.correlationId,
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"CustomerId" : attributes.uriParams.customerId
}]]]></http:uri-params>
			<http:response-validator>
				<http:success-status-code-validator values="200..499" />
			</http:response-validator>
		</http:request>
		<choice doc:name="Choice" doc:id="8cbb9061-82db-4a5f-8383-c05432d0d19d" >
			<when expression='payload.status == "Fail"' >
				<ee:transform doc:name="set final error message" doc:id="635bf292-7906-4647-87af-2e6cbab47301" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  Message: "There isn't customer with ID=" ++ vars.id ++ " to add orders"
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
404]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="ed13e523-9869-4668-be81-b9e1189a4be8" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: vars.env,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,   &#10;    details:{&#10;	    message: payload.Message&#10;    }                          &#10;}]" />
			</when>
			<otherwise >
				<http:request method="DELETE" doc:name="delete-customer" doc:id="79e610ed-e987-4126-a6fc-172de370396d" config-ref="HTTP_Request_apy-sys" path="${api-sys.path.customers}/{customerId}" responseTimeout="30000" >
					<http:headers ><![CDATA[#[output application/java
---
{
	"X-Correlation-ID" : vars.correlationId
}]]]></http:headers>
					<http:uri-params ><![CDATA[#[output application/java
---
{
	"customerId" : payload.customer.user_id
}]]]></http:uri-params>
				</http:request>
				<ee:transform doc:name="set final message" doc:id="62a67fd3-1180-49b8-bdd0-976f25a4fca0" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	message: "User deleted successfully"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="702bcbe3-9d67-4f1f-bca2-2559d700b910" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    timestamp: now() as String {format: &quot;dd-MM-yyyy&quot;},&#10;    level:  Mule::p('system.log.level') default &quot;INFO&quot;,&#10;    environment: Mule::p('mule.env') default &quot;local&quot;,&#10;    apiName: app.name,&#10;    flow: flow.name,&#10;    correlationId: vars.correlationId,    &#10;    httpMethod: attributes.method,   &#10;    details:{&#10;	    message: &quot;Customer successfully delete into PAPI.&quot;,&#10;	    affected_rows: payload.affectedRows default 1 ,&#10;&#10;    }                          &#10;}]" />
			</otherwise>
		</choice>
		<error-handler >
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="2ab4535c-e030-478d-98c8-83f4684a149c" >
				<logger level="INFO" doc:name="error-logger-data" doc:id="ce613e59-7ccd-41c9-97bb-33f9a5c11f5b" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  "log_type": "PROCESS_API_ERROR",&#10;  "API_NAME": app.name,&#10;  "correlation_id": vars.correlationId,&#10;  "flow_name": flow.name,&#10;  httpMethod: attributes.method,&#10;  "timestamp": now(),&#10;  "details": {&#10;    "target_id": attributes.uriParams.id default "UNKNOWN",&#10;    "error_type": (error.errorType.namespace default "DB") ++ ":" ++ (error.errorType.identifier default "UNKNOWN"),&#10;    "error_description": error.description default "No description available",&#10;    "message": "Failed to "++ attributes.method ++ " customer from PAPI."&#10;  }&#10;}]' />
				<ee:transform doc:name="error-response" doc:id="c3db38c6-433a-4992-96cc-1616598ad9d3" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "success": false,
  "correlation_id": vars.correlationId,
  "error": {
    "code": if (error.errorType.identifier == "CONNECTIVITY") "SERVICE_UNAVAILABLE" else "INTERNAL_SERVER_ERROR",
    "message": "Error processing the request on the target process.",
    "description": error.description default "No technical details available",
    "timestamp": now() as String {format: "yyyy-MM-dd'T'HH:MM:ss'Z'"}
  }
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</on-error-continue>
		</error-handler>
	</flow>
</mule>
